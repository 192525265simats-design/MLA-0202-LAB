Step 6: Prediction Functio
def predict(tree, sample):

    if not isinstance(tree, dict):
        return tree

    root = next(iter(tree))

    value = sample[root]

    if value in tree[root]:
        return predict(tree[root][value], sample)
    else:
        return "Unknown"

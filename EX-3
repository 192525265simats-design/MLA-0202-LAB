Step 2: Entropy Function
def entropy(target):
    counts = Counter(target)
    total = len(target)
    ent = 0

    for count in counts.values():
        probability = count / total
        ent -= probability * math.log2(probability)

    return ent
 Step 3: Information Gain
def information_gain(data, attribute, target):
    total_entropy = entropy(data[target])

    values = data[attribute].unique()

    weighted_entropy = 0

    for value in values:
        subset = data[data[attribute] == value]
        weighted_entropy += (len(subset) / len(data)) * entropy(subset[target])

    return total_entropy - weighted_entropy
 Step 4: ID3 Algorithm
def id3(data, original_data, features, target):

     If all target values are same
    if len(data[target].unique()) == 1:
        return data[target].iloc[0]

    If dataset becomes empty
    elif len(data) == 0:
        return original_data[target].mode()[0]

     If no features left
    elif len(features) == 0:
        return data[target].mode()[0]

    else:
        gains = [information_gain(data, feature, target) for feature in features]
        best_feature = features[gains.index(max(gains))]

        tree = {best_feature: {}}

        remaining_features = [f for f in features if f != best_feature]

        for value in data[best_feature].unique():
            subset = data[data[best_feature] == value]

            subtree = id3(subset,
                          original_data,
                          remaining_features,
                          target)

            tree[best_feature][value] = subtree

        return tree
